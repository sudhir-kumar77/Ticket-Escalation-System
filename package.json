{
  "name": "nvara-request-management",
  "description": "Enterprise-grade request management, workflow orchestration, and automated SLA escalation engine.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @nvara/web",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "start:api": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/main.js",
    "start:web": "npm run preview --workspace @nvara/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @nvara/db",
    "db:seed": "npm run seed --workspace @nvara/db",
    "db:validate": "npm run validate:gate --workspace @nvara/db",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "build": "npm run build --workspace @nvara/config && npm run build --workspace @nvara/db && npm run build --workspace @nvara/api && npm run build --workspace @nvara/worker && npm run build --workspace @nvara/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "node --env-file=.env tests/integration/client-request.mjs",
    "test:integration:auth": "node --env-file=.env tests/integration/auth_boundary.mjs",
    "test:integration:workflow": "node --env-file=.env tests/integration/workflow.mjs",
    "test:integration:hardening": "node --env-file=.env tests/integration/concurrency.mjs",
    "test:integration:worker": "node --env-file=.env --import tsx tests/integration/worker-fixture.mjs",
    "test:integration:user-mgmt": "node --env-file=.env tests/integration/user_management_security.mjs",
    "test:integration:tracker": "node --env-file=.env tests/integration/tracker_security.mjs",
    "test:integration:audit": "node --env-file=.env tests/integration/audit_findings_regression.mjs",
    "test:integration:remediation": "node --env-file=.env tests/integration/adversarial_remediation_regression.mjs",
    "test:integration:rc": "node --env-file=.env tests/integration/release_candidate_acceptance.mjs",
    "test:integration:rt": "node --env-file=.env tests/integration/rt_add_team_member_suite.mjs",
    "test:integration:auth-forensic": "node --env-file=.env tests/integration/authorization_forensic_suite.mjs",
    "test:integration:authn-forensic": "node --env-file=.env tests/integration/authentication_forensic_suite.mjs",
    "test:integration:notifications": "node --env-file=.env tests/integration/notifications_forensic_suite.mjs",
    "test:integration:notification-reconciliation": "node --env-file=.env --import tsx tests/integration/notification_evidence_reconciliation.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:integration && npm run test:integration:auth && npm run test:integration:workflow && npm run test:integration:hardening && npm run test:integration:user-mgmt && npm run test:integration:tracker && npm run test:integration:audit && npm run test:integration:remediation && npm run test:integration:rc && npm run test:integration:rt && npm run test:integration:auth-forensic && npm run test:integration:authn-forensic && npm run test:integration:notifications && npm run test:integration:notification-reconciliation"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}
